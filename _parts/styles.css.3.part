r: var(--green-900);
}

.drop-table .high-end {
  color: var(--slate-500);
  font-style: italic;
}

/* —— Empty / error —— */
.empty-card,
.error-card {
  text-align: center;
  padding: 1.75rem 1.25rem;
}

.empty-icon {
  margin: 0 0 0.5rem;
  font-size: 1.75rem;
  color: var(--green-700);
  opacity: 0.7;
}

.empty-title,
.error-title {
  margin: 0 0 0.35rem;
  font-weight: 700;
  font-size: 1.0625rem;
}

.empty-body,
.error-body {
  margin: 0;
  color: var(--slate-500);
  font-size: 0.9375rem;
}

.error-card {
  background: var(--red-50);
  border-color: #fecaca;
}

.error-title {
  color: var(--red-700);
}

.error-body {
  color: #7f1d1d;
}

/* —— How it works —— */
.how-it-works {
  background: var(--white);
  border: 1px solid var(--slate-200);
  border-radius: var(--radius);
  margin-top: 0.25rem;
  box-shadow: var(--shadow);
}

.how-it-works summary {
  padding: 1rem 1.15rem;
  font-weight: 650;
  cursor: pointer;
  list-style: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  min-height: var(--touch);
  color: var(--green-900);
}

.how-it-works summary::-webkit-details-marker {
  display: none;
}

.how-it-works summary::after {
  content: "+";
  font-size: 1.25rem;
  font-weight: 400;
  color: var(--slate-500);
}

.how-it-works[open] summary::after {
  content: "−";
}

.how-body {
  padding: 0 1.15rem 1.15rem;
  color: var(--slate-700);
  font-size: 0.9375rem;
}

.how-body p {
  margin: 0 0 0.75rem;
}

.how-body p:last-child {
  margin-bottom: 0;
}

.formula {
  background: var(--green-100);
  border-radius: var(--radius-sm);
  padding: 0.75rem 0.9rem;
  color: var(--green-950);
}

/* —— Footer —— */
.site-footer {
  text-align: center;
  padding: 1rem;
  padding-bottom: max(1rem, env(safe-area-inset-bottom));
  font-size: 0.75rem;
  color: var(--slate-500);
}

.site-footer p {
  margin: 0;
}

/* —— Desktop —— */
@media (min-width: 640px) {
  .site-header {
    padding: 1.25rem 1.5rem;
  }

  .brand h1 {
    font-size: 1.375rem;
  }

  .main {
    padding: 1.75rem 1.5rem 3rem;
  }

  .card {
    padding: 1.35rem 1.5rem 1.5rem;
  }

  .qty-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .qty-card.span-2 {
    grid-column: auto;
  }
}

@media (prefers-reduced-motion: reduce) {
  * {
    transition: none !important;
  }
}
